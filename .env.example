# Free API Hub Environment Configuration Template
# Copy this file to .env (or backend/.env) to customize your deployment.

# ================================
# Backend Configuration (FastAPI)
# ================================
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="Free API Hub"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Allowed CORS origins (comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Outbound proxy and health-check timeout (seconds)
PROXY_TIMEOUT_SECONDS=10

# Security limits
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_OUTBOUND_REQUESTS=10
MAX_REQUEST_BODY_BYTES=1048576
MAX_RESPONSE_BODY_BYTES=5242880

# ================================
# Frontend Configuration (Vite/React)
# ================================
# Leave empty for relative '/api/v1' routing (recommended for Docker & Vite dev proxy)
# Set only if your backend is hosted on a separate external domain
# VITE_API_BASE_URL=http://localhost:8000
